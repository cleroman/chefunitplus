// =============================================================
// ChefUnitPlus - AdminDashboard (avec toutes les stats)
// =============================================================

import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import '../../widgets/layout/admin_drawer.dart';

import '../../controllers/auth_controller.dart';
import '../../controllers/complaint_controller.dart';
import '../../controllers/enrollment_controller.dart';
import '../../controllers/formation_controller.dart';
import '../../controllers/password_request_controller.dart';
import '../../controllers/scout_group_controller.dart';
import '../../controllers/user_controller.dart';
import '../../core/constants/app_colors.dart';
import '../../core/constants/app_sizes.dart';
import '../../core/constants/role_constants.dart';
import '../../core/routes/app_routes.dart';
import '../../core/theme/gradients.dart';
import '../../core/utils/formatters.dart';
import '../../models/user.dart';
import '../../widgets/layout/role_drawer.dart';
import 'user_details_screen.dart';

class AdminDashboard extends StatefulWidget {
  const AdminDashboard({super.key});

  @override
  State<AdminDashboard> createState() => _AdminDashboardState();
}

class _AdminDashboardState extends State<AdminDashboard> {
  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addPostFrameCallback((_) => _load());
  }

  Future<void> _load() async {
    if (!mounted) return;
    await Future.wait([
      context.read<UserController>().loadAll(),
      context.read<ScoutGroupController>().loadAll(),
      context.read<ComplaintController>().loadAll(),
      context.read<PasswordRequestController>().loadPending(),
      context.read<FormationController>().loadMine(),
      context.read<EnrollmentController>().loadPending(),
    ]);
  }

  @override
  Widget build(BuildContext context) {
    final auth = context.watch<AuthController>();
    final users = context.watch<UserController>();
    final groups = context.watch<ScoutGroupController>();
    final complaints = context.watch<ComplaintController>();
    final pwds = context.watch<PasswordRequestController>();
    final formations = context.watch<FormationController>();
    final enrollments = context.watch<EnrollmentController>();
    final user = auth.currentUser;

    return Scaffold(
      backgroundColor: AppColors.background,
      drawer: const RoleDrawer(),
      body: RefreshIndicator(
        onRefresh: _load,
        child: CustomScrollView(
          slivers: [
            // ================= HEADER =================
            SliverToBoxAdapter(
              child: Container(
                decoration: const BoxDecoration(
                  gradient: AppGradients.admin,
                  borderRadius:
                      BorderRadius.vertical(bottom: Radius.circular(24)),
                ),
                child: SafeArea(
                  bottom: false,
                  child: Padding(
                    padding: const EdgeInsets.fromLTRB(20, 12, 20, 24),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Row(
                          children: [
                            Builder(
                              builder: (ctx) => IconButton(
                                onPressed: () =>
                                    Scaffold.of(ctx).openDrawer(),
                                icon: const Icon(Icons.menu,
                                    color: Colors.white),
                              ),
                            ),
                            const Spacer(),
                            IconButton(
                              onPressed: () => Navigator.pushNamed(
                                  context, AppRoutes.profile),
                              icon: const Icon(Icons.person_outline,
                                  color: Colors.white),
                            ),
                          ],
                        ),
                        const SizedBox(height: 8),
                        Text(
                          'Bonjour, ${user?.fullName.split(' ').first ?? ''}',
                          style: const TextStyle(
                            color: Colors.white,
                            fontSize: 24,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                        const SizedBox(height: 4),
                        const Text(
                          'Console de gestion ChefUnitPlus',
                          style: TextStyle(color: Colors.white70, fontSize: 13),
                        ),
                        const SizedBox(height: 20),
                        _buildMainCounter(
                          total: users.totalCount,
                          active: users.activeCount,
                          inactive: users.inactiveCount,
                        ),
                      ],
                    ),
                  ),
                ),
              ),
            ),

            // ================= ALERTES =================
            if (complaints.openCount > 0 || pwds.pendingCount > 0)
              SliverPadding(
                padding: const EdgeInsets.fromLTRB(20, 20, 20, 8),
                sliver: SliverToBoxAdapter(
                  child: _buildAlerts(
                    complaints: complaints.openCount,
                    passwords: pwds.pendingCount,
                  ),
                ),
              ),

            // ================= STATS PRINCIPALES =================
            const SliverPadding(
              padding: EdgeInsets.fromLTRB(20, 20, 20, 10),
              sliver: SliverToBoxAdapter(
                child: Text('Statistiques globales',
                    style:
                        TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
              ),
            ),
            SliverPadding(
              padding: const EdgeInsets.symmetric(horizontal: 20),
              sliver: SliverToBoxAdapter(
                child: _buildStatsGrid(users, groups.count, formations.formations.length, enrollments.pending.length),
              ),
            ),

            // ================= REPARTITION ROLES =================
            const SliverPadding(
              padding: EdgeInsets.fromLTRB(20, 24, 20, 10),
              sliver: SliverToBoxAdapter(
                child: Text('Repartition par role',
                    style:
                        TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
              ),
            ),
            SliverPadding(
              padding: const EdgeInsets.symmetric(horizontal: 20),
              sliver: SliverToBoxAdapter(
                child: _buildRolesBreakdown(users),
              ),
            ),

            // ================= DERNIERS UTILISATEURS =================
            if (users.users.isNotEmpty) ...[
              SliverPadding(
                padding: const EdgeInsets.fromLTRB(20, 24, 20, 10),
                sliver: SliverToBoxAdapter(
                  child: Row(
                    children: [
                      const Text('Derniers utilisateurs',
                          style: TextStyle(
                              fontSize: 18, fontWeight: FontWeight.bold)),
                      const Spacer(),
                      TextButton(
                        onPressed: () => Navigator.pushNamed(
                            context, AppRoutes.adminUsers),
                        child: const Text('Voir tout'),
                      ),
                    ],
                  ),
                ),
              ),
              SliverPadding(
                padding: const EdgeInsets.fromLTRB(20, 0, 20, 20),
                sliver: SliverToBoxAdapter(
                  child: _buildRecentUsers(users.users.take(5).toList()),
                ),
              ),
            ],

            // ================= ACTIONS =================
            const SliverPadding(
              padding: EdgeInsets.fromLTRB(20, 8, 20, 12),
              sliver: SliverToBoxAdapter(
                child: Text('Administration',
                    style:
                        TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
              ),
            ),
            SliverPadding(
              padding: const EdgeInsets.fromLTRB(20, 0, 20, 40),
              sliver: SliverToBoxAdapter(
                child: GridView.count(
                  crossAxisCount: 2,
                  shrinkWrap: true,
                  physics: const NeverScrollableScrollPhysics(),
                  crossAxisSpacing: 12,
                  mainAxisSpacing: 12,
                  childAspectRatio: 1.15,
                  children: [
                    _actionCard(context, Icons.people_outline,
                        'Utilisateurs', AppColors.mauve,
                        AppRoutes.adminUsers,
                        badge: users.totalCount),
                    _actionCard(context, Icons.upgrade_outlined,
                        'Promouvoir', AppColors.kaki,
                        AppRoutes.adminPromote),
                    _actionCard(context, Icons.groups_outlined,
                        'Groupes Scout', AppColors.mauveDark,
                        AppRoutes.adminScoutGroups,
                        badge: groups.count > 0 ? groups.count : null),
                    _actionCard(context, Icons.report_problem_outlined,
                        'Plaintes', AppColors.warning,
                        AppRoutes.adminComplaints,
                        badge: complaints.openCount > 0
                            ? complaints.openCount
                            : null),
                    _actionCard(context, Icons.key_outlined,
                        'Mots de passe', AppColors.danger,
                        AppRoutes.adminPasswordRequests,
                        badge: pwds.pendingCount > 0
                            ? pwds.pendingCount
                            : null),
                    _actionCard(context, Icons.bar_chart_outlined,
                        'Statistiques', AppColors.success,
                        AppRoutes.adminStats),
                    _actionCard(context, Icons.receipt_long_outlined,
                        'Paiements', AppColors.kakiDark,
                        AppRoutes.adminPayments),
                    _actionCard(context, Icons.settings_outlined,
                        'Parametres', AppColors.textMuted,
                        AppRoutes.adminSettings),
                  ],
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  // ===========================================================
  // COMPTEUR PRINCIPAL
  // ===========================================================
  Widget _buildMainCounter({
    required int total,
    required int active,
    required int inactive,
  }) {
    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: Colors.white.withValues(alpha: 0.18),
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: Colors.white.withValues(alpha: 0.25)),
      ),
      child: Row(
        children: [
          const Icon(Icons.people_alt_outlined,
              color: Colors.white, size: 36),
          const SizedBox(width: 14),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  '$total',
                  style: const TextStyle(
                    color: Colors.white,
                    fontSize: 30,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                const Text('Utilisateurs au total',
                    style: TextStyle(color: Colors.white70, fontSize: 12)),
              ],
            ),
          ),
          Column(
            crossAxisAlignment: CrossAxisAlignment.end,
            children: [
              Row(
                children: [
                  Container(
                    width: 10,
                    height: 10,
                    decoration: const BoxDecoration(
                      color: AppColors.successLight,
                      shape: BoxShape.circle,
                    ),
                  ),
                  const SizedBox(width: 6),
                  Text('$active actifs',
                      style: const TextStyle(
                          color: Colors.white,
                          fontSize: 13,
                          fontWeight: FontWeight.w600)),
                ],
              ),
              const SizedBox(height: 8),
              Row(
                children: [
                  Container(
                    width: 10,
                    height: 10,
                    decoration: const BoxDecoration(
                      color: AppColors.dangerLight,
                      shape: BoxShape.circle,
                    ),
                  ),
                  const SizedBox(width: 6),
                  Text('$inactive inactifs',
                      style: const TextStyle(
                          color: Colors.white70, fontSize: 13)),
                ],
              ),
            ],
          ),
        ],
      ),
    );
  }

  // ===========================================================
  // ALERTES
  // ===========================================================
  Widget _buildAlerts({required int complaints, required int passwords}) {
    return Container(
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: AppColors.warningSoft,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: AppColors.warning.withValues(alpha: 0.4)),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Row(
            children: [
              Icon(Icons.warning_amber_outlined, color: AppColors.warning),
              SizedBox(width: 10),
              Text('Alertes en attente',
                  style: TextStyle(
                      fontWeight: FontWeight.bold, fontSize: 14)),
            ],
          ),
          const SizedBox(height: 10),
          if (complaints > 0)
            Padding(
              padding: const EdgeInsets.only(bottom: 4),
              child: Row(
                children: [
                  const Icon(Icons.circle,
                      size: 6, color: AppColors.warning),
                  const SizedBox(width: 8),
                  Text('$complaints plainte(s) a traiter',
                      style: const TextStyle(fontSize: 13)),
                ],
              ),
            ),
          if (passwords > 0)
            Row(
              children: [
                const Icon(Icons.circle,
                    size: 6, color: AppColors.warning),
                const SizedBox(width: 8),
                Text('$passwords demande(s) de mot de passe',
                    style: const TextStyle(fontSize: 13)),
              ],
            ),
        ],
      ),
    );
  }

  // ===========================================================
  // GRILLE DE STATS
  // ===========================================================
  Widget _buildStatsGrid(
    UserController users,
    int groups,
    int formations,
    int pendingEnrollments,
  ) {
    return GridView.count(
      crossAxisCount: 2,
      shrinkWrap: true,
      physics: const NeverScrollableScrollPhysics(),
      crossAxisSpacing: 12,
      mainAxisSpacing: 12,
      childAspectRatio: 1.4,
      children: [
        _statCard(
          Icons.check_circle_outline,
          '${users.activeCount}',
          'Actifs',
          AppColors.success,
        ),
        _statCard(
          Icons.block_outlined,
          '${users.inactiveCount}',
          'Inactifs',
          AppColors.danger,
        ),
        _statCard(
          Icons.groups_outlined,
          '$groups',
          'Groupes scout',
          AppColors.kaki,
        ),
        _statCard(
          Icons.school_outlined,
          '$formations',
          'Formations',
          AppColors.mauve,
        ),
        _statCard(
          Icons.pending_actions,
          '$pendingEnrollments',
          'En attente',
          AppColors.warning,
        ),
        _statCard(
          Icons.verified_outlined,
          '${users.adminCount + users.directorCount}',
          'Staff',
          AppColors.mauveDark,
        ),
      ],
    );
  }

  // ===========================================================
  // REPARTITION ROLES
  // ===========================================================
  Widget _buildRolesBreakdown(UserController users) {
    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(AppSizes.radiusLg),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withValues(alpha: 0.04),
            blurRadius: 10,
            offset: const Offset(0, 4),
          ),
        ],
      ),
      child: Column(
        children: [
          _roleRow(
            UserRole.admin,
            users.adminCount,
            users.totalCount,
          ),
          const SizedBox(height: 14),
          _roleRow(
            UserRole.directeur,
            users.directorCount,
            users.totalCount,
          ),
          const SizedBox(height: 14),
          _roleRow(
            UserRole.formateur,
            users.trainerCount,
            users.totalCount,
          ),
          const SizedBox(height: 14),
          _roleRow(
            UserRole.apprenant,
            users.learnerCount,
            users.totalCount,
          ),
        ],
      ),
    );
  }

  Widget _roleRow(UserRole role, int count, int total) {
    final percent = total == 0 ? 0.0 : count / total;
    return Row(
      children: [
        Container(
          padding: const EdgeInsets.all(8),
          decoration: BoxDecoration(
            color: role.color.withValues(alpha: 0.12),
            borderRadius: BorderRadius.circular(10),
          ),
          child: Icon(role.icon, color: role.color, size: 18),
        ),
        const SizedBox(width: 12),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row(
                children: [
                  Text(role.label,
                      style: const TextStyle(
                          fontSize: 13,
                          fontWeight: FontWeight.w600)),
                  const Spacer(),
                  Text('$count',
                      style: TextStyle(
                          fontSize: 14,
                          fontWeight: FontWeight.bold,
                          color: role.color)),
                ],
              ),
              const SizedBox(height: 6),
              ClipRRect(
                borderRadius: BorderRadius.circular(4),
                child: LinearProgressIndicator(
                  value: percent,
                  minHeight: 6,
                  backgroundColor: role.color.withValues(alpha: 0.12),
                  valueColor: AlwaysStoppedAnimation<Color>(role.color),
                ),
              ),
            ],
          ),
        ),
      ],
    );
  }

  // ===========================================================
  // DERNIERS UTILISATEURS
  // ===========================================================
  Widget _buildRecentUsers(List<User> users) {
    return Container(
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(AppSizes.radiusLg),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withValues(alpha: 0.04),
            blurRadius: 10,
            offset: const Offset(0, 4),
          ),
        ],
      ),
      child: Column(
        children: users.asMap().entries.map((entry) {
          final isLast = entry.key == users.length - 1;
          final u = entry.value;
          return InkWell(
            onTap: () => Navigator.push(
              context,
              MaterialPageRoute(
                builder: (_) => UserDetailsScreen(userId: u.id),
              ),
            ),
            child: Container(
              padding: const EdgeInsets.all(14),
              decoration: BoxDecoration(
                border: isLast
                    ? null
                    : Border(
                        bottom: BorderSide(
                          color: AppColors.divider.withValues(alpha: 0.5),
                        ),
                      ),
              ),
              child: Row(
                children: [
                  Container(
                    width: 42,
                    height: 42,
                    decoration: BoxDecoration(
                      color: u.role.color.withValues(alpha: 0.15),
                      shape: BoxShape.circle,
                    ),
                    child: Center(
                      child: Text(
                        Formatters.initials(u.fullName),
                        style: TextStyle(
                          fontSize: 14,
                          fontWeight: FontWeight.bold,
                          color: u.role.color,
                        ),
                      ),
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          u.fullName,
                          maxLines: 1,
                          overflow: TextOverflow.ellipsis,
                          style: const TextStyle(
                            fontSize: 14,
                            fontWeight: FontWeight.w600,
                          ),
                        ),
                        const SizedBox(height: 2),
                        Text(
                          u.email,
                          maxLines: 1,
                          overflow: TextOverflow.ellipsis,
                          style: const TextStyle(
                            fontSize: 11,
                            color: AppColors.textMuted,
                          ),
                        ),
                      ],
                    ),
                  ),
                  Container(
                    padding: const EdgeInsets.symmetric(
                      horizontal: 8,
                      vertical: 3,
                    ),
                    decoration: BoxDecoration(
                      color: u.isActive
                          ? AppColors.successSoft
                          : AppColors.dangerSoft,
                      borderRadius: BorderRadius.circular(6),
                    ),
                    child: Text(
                      u.isActive ? 'Actif' : 'Suspendu',
                      style: TextStyle(
                        fontSize: 10,
                        fontWeight: FontWeight.w600,
                        color: u.isActive
                            ? AppColors.successDark
                            : AppColors.dangerDark,
                      ),
                    ),
                  ),
                ],
              ),
            ),
          );
        }).toList(),
      ),
    );
  }

  // ===========================================================
  // HELPERS
  // ===========================================================
  Widget _statCard(
      IconData icon, String value, String label, Color color) {
    return Container(
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(14),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withValues(alpha: 0.04),
            blurRadius: 8,
            offset: const Offset(0, 3),
          ),
        ],
      ),
      child: Row(
        children: [
          Container(
            padding: const EdgeInsets.all(10),
            decoration: BoxDecoration(
              color: color.withValues(alpha: 0.12),
              borderRadius: BorderRadius.circular(10),
            ),
            child: Icon(icon, color: color, size: 20),
          ),
          const SizedBox(width: 10),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Text(
                  value,
                  style: TextStyle(
                    fontSize: 20,
                    fontWeight: FontWeight.bold,
                    color: color,
                  ),
                ),
                Text(
                  label,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(
                    fontSize: 11,
                    color: AppColors.textMuted,
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _actionCard(
    BuildContext context,
    IconData icon,
    String label,
    Color color,
    String route, {
    int? badge,
  }) {
    return Material(
      color: Colors.white,
      borderRadius: BorderRadius.circular(16),
      child: InkWell(
        onTap: () => Navigator.pushNamed(context, route),
        borderRadius: BorderRadius.circular(16),
        child: Container(
          padding: const EdgeInsets.all(14),
          decoration: BoxDecoration(
            borderRadius: BorderRadius.circular(16),
            boxShadow: [
              BoxShadow(
                color: Colors.black.withValues(alpha: 0.05),
                blurRadius: 10,
                offset: const Offset(0, 4),
              ),
            ],
          ),
          child: Stack(
            children: [
              Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Container(
                    padding: const EdgeInsets.all(10),
                    decoration: BoxDecoration(
                      color: color.withValues(alpha: 0.12),
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: Icon(icon, color: color, size: 22),
                  ),
                  Text(
                    label,
                    style: const TextStyle(
                      fontSize: 12.5,
                      fontWeight: FontWeight.w600,
                      color: AppColors.textPrimary,
                      height: 1.3,
                    ),
                  ),
                ],
              ),
              if (badge != null && badge > 0)
                Positioned(
                  top: 0,
                  right: 0,
                  child: Container(
                    padding: const EdgeInsets.symmetric(
                        horizontal: 8, vertical: 3),
                    decoration: BoxDecoration(
                      color: AppColors.danger,
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: Text(
                      '$badge',
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 11,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                ),
            ],
          ),
        ),
      ),
    );
  }
}