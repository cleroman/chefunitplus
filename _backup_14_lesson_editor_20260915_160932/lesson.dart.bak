// =============================================================
// ChefUnitPlus - Modle Lesson (leon)
// Une leon appartient  un module
// =============================================================


enum LessonType {
  text,
  video,
  pdf,
  quiz,
  audio,
}

extension LessonTypeX on LessonType {
  String get label => switch (this) {
        LessonType.text => 'Texte',
        LessonType.video => 'Vido',
        LessonType.pdf => 'PDF',
        LessonType.quiz => 'Quiz',
        LessonType.audio => 'Audio',
      };
}

class Lesson {
  final String id;
  final String moduleId;
  final String title;
  final String content; // texte principal
  final LessonType type;
  final String? videoUrl;
  final String? pdfUrl;
  final String? audioUrl;
  final String? thumbnailUrl;
  final int duration; // minutes
  final int order;
  final bool isPreview; // gratuit ? (aperu sans inscription)
  final DateTime? createdAt;
  final DateTime? updatedAt;

  const Lesson({
    required this.id,
    required this.moduleId,
    required this.title,
    this.content = '',
    this.type = LessonType.text,
    this.videoUrl,
    this.pdfUrl,
    this.audioUrl,
    this.thumbnailUrl,
    this.duration = 0,
    this.order = 0,
    this.isPreview = false,
    this.createdAt,
    this.updatedAt,
  });

  // ===========================================================
  // Y FACTORIES
  // ===========================================================
  factory Lesson.fromJson(Map<String, dynamic> json) {
    return Lesson(
      id: (json['id'] ?? json['_id'] ?? '').toString(),
      moduleId: (json['moduleId'] ?? '').toString(),
      title: json['title'] ?? '',
      content: json['content'] ?? '',
      type: _parseType(json['type']),
      videoUrl: json['videoUrl'],
      pdfUrl: json['pdfUrl'],
      audioUrl: json['audioUrl'],
      thumbnailUrl: json['thumbnailUrl'],
      duration: json['duration'] ?? 0,
      order: json['order'] ?? 0,
      isPreview: json['isPreview'] ?? false,
      createdAt: _parseDate(json['createdAt']),
      updatedAt: _parseDate(json['updatedAt']),
    );
  }

  // ===========================================================
  // Y" S?RIALISATION
  // ===========================================================
  Map<String, dynamic> toJson() => {
        'id': id,
        'moduleId': moduleId,
        'title': title,
        'content': content,
        'type': type.name,
        if (videoUrl != null) 'videoUrl': videoUrl,
        if (pdfUrl != null) 'pdfUrl': pdfUrl,
        if (audioUrl != null) 'audioUrl': audioUrl,
        if (thumbnailUrl != null) 'thumbnailUrl': thumbnailUrl,
        'duration': duration,
        'order': order,
        'isPreview': isPreview,
        if (createdAt != null) 'createdAt': createdAt!.toIso8601String(),
        if (updatedAt != null) 'updatedAt': updatedAt!.toIso8601String(),
      };

  // ===========================================================
  // Y"< COPYWITH
  // ===========================================================
  Lesson copyWith({
    String? id,
    String? moduleId,
    String? title,
    String? content,
    LessonType? type,
    String? videoUrl,
    String? pdfUrl,
    String? audioUrl,
    String? thumbnailUrl,
    int? duration,
    int? order,
    bool? isPreview,
    DateTime? createdAt,
    DateTime? updatedAt,
  }) {
    return Lesson(
      id: id ?? this.id,
      moduleId: moduleId ?? this.moduleId,
      title: title ?? this.title,
      content: content ?? this.content,
      type: type ?? this.type,
      videoUrl: videoUrl ?? this.videoUrl,
      pdfUrl: pdfUrl ?? this.pdfUrl,
      audioUrl: audioUrl ?? this.audioUrl,
      thumbnailUrl: thumbnailUrl ?? this.thumbnailUrl,
      duration: duration ?? this.duration,
      order: order ?? this.order,
      isPreview: isPreview ?? this.isPreview,
      createdAt: createdAt ?? this.createdAt,
      updatedAt: updatedAt ?? this.updatedAt,
    );
  }

  // ===========================================================
  // Y" GETTERS
  // ===========================================================
  bool get hasVideo => videoUrl != null && videoUrl!.isNotEmpty;
  bool get hasPdf => pdfUrl != null && pdfUrl!.isNotEmpty;
  bool get hasAudio => audioUrl != null && audioUrl!.isNotEmpty;

  String get durationLabel {
    if (duration < 60) return '${duration}min';
    final h = duration ~/ 60;
    final m = duration % 60;
    return m == 0 ? '${h}h' : '${h}h ${m}min';
  }

  // ===========================================================
  // Y COMPARAISON & TRI
  // ===========================================================
  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is Lesson && runtimeType == other.runtimeType && id == other.id;

  @override
  int get hashCode => id.hashCode;

  int compareTo(Lesson other) => order.compareTo(other.order);

  @override
  String toString() => 'Lesson(id: $id, title: $title, type: ${type.name})';

  // ===========================================================
  // Y HELPERS PRIV?S
  // ===========================================================
  static LessonType _parseType(dynamic v) {
    if (v == null) return LessonType.text;
    final name = v.toString().toLowerCase();
    return LessonType.values.firstWhere(
      (t) => t.name == name,
      orElse: () => LessonType.text,
    );
  }

  static DateTime? _parseDate(dynamic v) {
    if (v == null) return null;
    if (v is DateTime) return v;
    return DateTime.tryParse(v.toString());
  }
}