// =============================================================
// ChefUnitPlus - LessonEditorScreen
// Crfation / fdition d'une lefon dans un module
// =============================================================

import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

import '../../controllers/module_controller.dart';
import '../../core/constants/app_colors.dart';
import '../../core/utils/snackbar_helper.dart';
import '../../core/utils/validators.dart';
import '../../models/lesson.dart';
import '../../services/lesson_service.dart';


class LessonEditorScreen extends StatefulWidget {
  const LessonEditorScreen({super.key});

  @override
  State<LessonEditorScreen> createState() => _LessonEditorScreenState();
}

class _LessonEditorScreenState extends State<LessonEditorScreen> {
  final _formKey = GlobalKey<FormState>();
  final _titleCtrl = TextEditingController();
  final _contentCtrl = TextEditingController();
  final _videoUrlCtrl = TextEditingController();
  final _durationCtrl = TextEditingController(text: '0');
  final _orderCtrl = TextEditingController(text: '0');

  LessonType _type = LessonType.text;
  bool _isPreview = false;
  bool _loading = false;
  bool _initialized = false;

  String? _moduleId;
  String? _lessonId;
  Lesson? _existing;

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    if (_initialized) return;
    _initialized = true;

    final args = ModalRoute.of(context)?.settings.arguments;
    if (args is Map) {
      _moduleId = args['moduleId']?.toString();
      _lessonId = args['lessonId']?.toString();
      final lessonArg = args['lesson'];
      if (lessonArg is Lesson) _existing = lessonArg;
    }
  }

  @override
  void dispose() {
    _titleCtrl.dispose();
    _contentCtrl.dispose();
    _videoUrlCtrl.dispose();
    _durationCtrl.dispose();
    _orderCtrl.dispose();
    super.dispose();
  }

  bool get _isEditing => _lessonId != null;

  Future<void> _submit() async {
    FocusScope.of(context).unfocus();
    if (!_formKey.currentState!.validate()) return;

    if (_moduleId == null) {
      SnackbarHelper.error(context, 'Aucun module associf f  cette lefon');
      return;
    }

    setState(() => _loading = true);

    try {
      final service = context.read<LessonService>();
      final lessonService = service;

      if (_isEditing) {
        await lessonService.update(
          id: _lessonId!,
          title: _titleCtrl.text.trim(),
          content: _contentCtrl.text.trim(),
          type: _type,
          videoUrl: _videoUrlCtrl.text.trim().isEmpty
              ? null
              : _videoUrlCtrl.text.trim(),
          duration: int.tryParse(_durationCtrl.text.trim()) ?? 0,
          order: int.tryParse(_orderCtrl.text.trim()) ?? 0,
          isPreview: _isPreview,
        );
        if (!mounted) return;
        SnackbarHelper.success(context, 'Lefon mise f  jour');
        Navigator.pop(context, true);
      } else {
        await lessonService.create(
          moduleId: _moduleId!,
          title: _titleCtrl.text.trim(),
          content: _contentCtrl.text.trim(),
          type: _type,
          videoUrl: _videoUrlCtrl.text.trim().isEmpty
              ? null
              : _videoUrlCtrl.text.trim(),
          duration: int.tryParse(_durationCtrl.text.trim()) ?? 0,
          order: int.tryParse(_orderCtrl.text.trim()) ?? 0,
          isPreview: _isPreview,
        );
        if (!mounted) return;
        SnackbarHelper.success(context, 'Lefon crffe avec succfs');
        Navigator.pop(context, true);
      }
    } catch (e) {
      if (!mounted) return;
      SnackbarHelper.error(context, 'Erreur : $e');
    } finally {
      if (mounted) setState(() => _loading = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final module = context.watch<ModuleController>().modules.firstWhere(
          (m) => m.id == _moduleId,
          orElse: () => _existing != null
              ? context.read<ModuleController>().modules.firstWhere(
                    (m) => m.id == _existing!.moduleId,
                    orElse: () => throw StateError('Module introuvable'),
                  )
              : throw StateError('Module introuvable'),
        );

    return Scaffold(
      backgroundColor: AppColors.background,
      appBar: AppBar(
        title: Text(_isEditing ? 'Modifier la lefon' : 'Crfer une lefon'),
        backgroundColor: AppColors.kaki,
        foregroundColor: Colors.white,
      ),
      body: SafeArea(
        child: SingleChildScrollView(
          padding: const EdgeInsets.all(20),
          child: Form(
            key: _formKey,
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                // Info module
                Container(
                  padding: const EdgeInsets.all(14),
                  decoration: BoxDecoration(
                    color: AppColors.kakiSoft,
                    borderRadius: BorderRadius.circular(12),
                  ),
                  child: Row(
                    children: [
                      const Icon(
                        Icons.menu_book_outlined,
                        color: AppColors.kakiDark,
                        size: 20,
                      ),
                      const SizedBox(width: 12),
                      Expanded(
                        child: Text(
                          'Module : ${module.title}',
                          style: const TextStyle(
                            fontSize: 13,
                            fontWeight: FontWeight.w600,
                            color: AppColors.kakiDark,
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 20),

                // Titre
                TextFormField(
                  controller: _titleCtrl,
                  textInputAction: TextInputAction.next,
                  textCapitalization: TextCapitalization.sentences,
                  decoration: const InputDecoration(
                    labelText: 'Titre de la lefon',
                    hintText: 'Ex : Les 5 principes du leadership',
                    prefixIcon: Icon(Icons.title),
                  ),
                  validator: (v) => Validators.required(v),
                ),
                const SizedBox(height: 16),

                // Type de lefon
                DropdownButtonFormField<LessonType>(
                  initialValue: _type,
                  decoration: const InputDecoration(
                    labelText: 'Type de contenu',
                    prefixIcon: Icon(Icons.category_outlined),
                  ),
                  items: LessonType.values
                      .map(
                        (t) => DropdownMenuItem(
                          value: t,
                          child: Row(
                            children: [
                              Icon(_iconForType(t), size: 18),
                              const SizedBox(width: 8),
                              Text(t.label),
                            ],
                          ),
                        ),
                      )
                      .toList(),
                  onChanged: (v) {
                    if (v != null) setState(() => _type = v);
                  },
                ),
                const SizedBox(height: 16),

                // Contenu texte
                TextFormField(
                  controller: _contentCtrl,
                  maxLines: 8,
                  textCapitalization: TextCapitalization.sentences,
                  decoration: const InputDecoration(
                    labelText: 'Contenu',
                    hintText: 'Rfdigez le contenu de la lefon...',
                    alignLabelWithHint: true,
                  ),
                ),
                const SizedBox(height: 16),

                // URL vidfo (si type vidfo)
                if (_type == LessonType.video) ...[
                  TextFormField(
                    controller: _videoUrlCtrl,
                    keyboardType: TextInputType.url,
                    decoration: const InputDecoration(
                      labelText: 'URL de la vidfo',
                      hintText: 'https://...',
                      prefixIcon: Icon(Icons.video_library_outlined),
                    ),
                  ),
                  const SizedBox(height: 16),
                ],

                // Durfe + ordre
                Row(
                  children: [
                    Expanded(
                      child: TextFormField(
                        controller: _durationCtrl,
                        keyboardType: TextInputType.number,
                        decoration: const InputDecoration(
                          labelText: 'Durfe (min)',
                          prefixIcon: Icon(Icons.access_time),
                        ),
                      ),
                    ),
                    const SizedBox(width: 12),
                    Expanded(
                      child: TextFormField(
                        controller: _orderCtrl,
                        keyboardType: TextInputType.number,
                        decoration: const InputDecoration(
                          labelText: 'Ordre',
                          prefixIcon: Icon(Icons.format_list_numbered),
                        ),
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 16),

                // Preview
                CheckboxListTile(
                  value: _isPreview,
                  onChanged: (v) => setState(() => _isPreview = v ?? false),
                  contentPadding: EdgeInsets.zero,
                  controlAffinity: ListTileControlAffinity.leading,
                  title: const Text(
                    'Aperfu gratuit',
                    style: TextStyle(fontSize: 14, fontWeight: FontWeight.w600),
                  ),
                  subtitle: const Text(
                    'Cette lefon sera visible avant paiement',
                    style: TextStyle(fontSize: 12, color: AppColors.textMuted),
                  ),
                ),
                const SizedBox(height: 24),

                // Bouton submit
                SizedBox(
                  height: 52,
                  child: ElevatedButton.icon(
                    onPressed: _loading ? null : _submit,
                    style: ElevatedButton.styleFrom(
                      backgroundColor: AppColors.kaki,
                    ),
                    icon: _loading
                        ? const SizedBox(
                            width: 20,
                            height: 20,
                            child: CircularProgressIndicator(
                              color: Colors.white,
                              strokeWidth: 2.5,
                            ),
                          )
                        : const Icon(Icons.save_outlined),
                    label: Text(
                      _isEditing ? 'Enregistrer' : 'Crfer la lefon',
                    ),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }

  IconData _iconForType(LessonType t) {
    switch (t) {
      case LessonType.text:  return Icons.text_fields;
      case LessonType.video: return Icons.play_circle_outline;
      case LessonType.pdf:   return Icons.picture_as_pdf_outlined;
      case LessonType.quiz:  return Icons.quiz_outlined;
      case LessonType.audio: return Icons.headphones_outlined;
    }
  }
}