// =============================================================
// ChefUnitPlus - Gestion des leçons
// CRUD par module
// =============================================================

import '../core/constants/api_constants.dart';
import '../core/errors/error_handler.dart';
import '../models/lesson.dart';
import 'api_client.dart';


class LessonService {
  final ApiClient api;

  LessonService(this.api);

  // ===========================================================
  // ðŸ“‹ LISTING
  // ===========================================================
  Future<List<Lesson>> listByModule(String moduleId) async {
    return ErrorHandler.guard(() async {
      final data = await api.get(
        ApiConstants.withId(ApiConstants.lessonsByModule, moduleId),
      );
      final raw = data['lessons'] as List? ?? const [];
      return raw
          .map((e) => Lesson.fromJson(e as Map<String, dynamic>))
          .toList()
        ..sort((a, b) => a.order.compareTo(b.order));
    }, context: 'LessonService.listByModule');
  }

  Future<Lesson> getById(String id) async {
    return ErrorHandler.guard(() async {
      final data = await api.get('${ApiConstants.lessons}/$id');
      return Lesson.fromJson(data['lesson'] as Map<String, dynamic>);
    }, context: 'LessonService.getById');
  }

  // ===========================================================
  // âœï¸ CRUD
  // ===========================================================
  Future<Lesson> create({
    required String moduleId,
    required String title,
    String content = '',
    LessonType type = LessonType.text,
    String? videoUrl,
    String? pdfUrl,
    String? audioUrl,
    int duration = 0,
    int order = 0,
    bool isPreview = false,
  }) async {
    return ErrorHandler.guard(() async {
      final data = await api.post(
        ApiConstants.lessons,
        body: {
          'moduleId': moduleId,
          'title': title,
          'content': content,
          'type': type.name,
          if (videoUrl != null) 'videoUrl': videoUrl,
          if (pdfUrl != null) 'pdfUrl': pdfUrl,
          if (audioUrl != null) 'audioUrl': audioUrl,
          'duration': duration,
          'order': order,
          'isPreview': isPreview,
        },
      );
      return Lesson.fromJson(data['lesson'] as Map<String, dynamic>);
    }, context: 'LessonService.create');
  }

  Future<Lesson> update({
    required String id,
    String? title,
    String? content,
    LessonType? type,
    String? videoUrl,
    String? pdfUrl,
    String? audioUrl,
    int? duration,
    int? order,
    bool? isPreview,
  }) async {
    return ErrorHandler.guard(() async {
      final data = await api.patch(
        '${ApiConstants.lessons}/$id',
        body: {
          if (title != null) 'title': title,
          if (content != null) 'content': content,
          if (type != null) 'type': type.name,
          if (videoUrl != null) 'videoUrl': videoUrl,
          if (pdfUrl != null) 'pdfUrl': pdfUrl,
          if (audioUrl != null) 'audioUrl': audioUrl,
          if (duration != null) 'duration': duration,
          if (order != null) 'order': order,
          if (isPreview != null) 'isPreview': isPreview,
        },
      );
      return Lesson.fromJson(data['lesson'] as Map<String, dynamic>);
    }, context: 'LessonService.update');
  }

  Future<void> delete(String id) async {
    return ErrorHandler.guard(() async {
      await api.delete('${ApiConstants.lessons}/$id');
    }, context: 'LessonService.delete');
  }

  // ===========================================================
  // ðŸ“Š PROGRESSION
  // ===========================================================
  Future<void> markCompleted(String lessonId) async {
    return ErrorHandler.guard(() async {
      await api.post('${ApiConstants.lessons}/$lessonId/complete');
    }, context: 'LessonService.markCompleted');
  }
}