// =============================================================
// ChefUnitPlus - LessonPlayerScreen
// Lecture d'une lefon (texte, vidfo, PDF, audio)
// =============================================================

import 'package:flutter/material.dart';

import '../../core/constants/app_colors.dart';
import '../../core/utils/formatters.dart';
import '../../models/lesson.dart';

class LessonPlayerScreen extends StatefulWidget {
  final String lessonId;
  final Lesson? lesson; // peut ftre passf directement

  const LessonPlayerScreen({
    super.key,
    required this.lessonId,
    this.lesson,
  });

  @override
  State<LessonPlayerScreen> createState() => _LessonPlayerScreenState();
}

class _LessonPlayerScreenState extends State<LessonPlayerScreen> {
  late Lesson _lesson;
  bool _completed = false;

  @override
  void initState() {
    super.initState();
    _lesson = widget.lesson ??
        Lesson(
          id: widget.lessonId,
          moduleId: '',
          title: 'Lefon #${widget.lessonId}',
          content: 'Chargement du contenu...',
        );
  }

  void _toggleCompleted() {
    setState(() => _completed = !_completed);
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(
          _completed
              ? 'Lefon marqufe comme terminfe'
              : 'Lefon marqufe comme non terminfe',
        ),
        backgroundColor: AppColors.success,
        behavior: SnackBarBehavior.floating,
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: AppColors.background,
      appBar: AppBar(
        title: Text(
          _lesson.title,
          maxLines: 1,
          overflow: TextOverflow.ellipsis,
        ),
        backgroundColor: AppColors.mauve,
        foregroundColor: Colors.white,
      ),
      body: Column(
        children: [
          // ---------------- MEDIA (vidfo / audio) ----------------
          if (_lesson.hasVideo)
            Container(
              height: 220,
              width: double.infinity,
              color: Colors.black,
              child: const Center(
                child: Column(
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: [
                    Icon(
                      Icons.play_circle_outline,
                      size: 72,
                      color: Colors.white,
                    ),
                    SizedBox(height: 8),
                    Text(
                      'Lecteur vidfo',
                      style: TextStyle(color: Colors.white70),
                    ),
                  ],
                ),
              ),
            ),

          // ---------------- CONTENU ----------------
          Expanded(
            child: SingleChildScrollView(
              padding: const EdgeInsets.all(20),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  // Info
                  Row(
                    children: [
                      Container(
                        padding: const EdgeInsets.symmetric(
                          horizontal: 10,
                          vertical: 4,
                        ),
                        decoration: BoxDecoration(
                          color: AppColors.mauveSoft,
                          borderRadius: BorderRadius.circular(8),
                        ),
                        child: Text(
                          _lesson.type.label,
                          style: const TextStyle(
                            fontSize: 11,
                            fontWeight: FontWeight.w600,
                            color: AppColors.mauveDark,
                          ),
                        ),
                      ),
                      const SizedBox(width: 8),
                      const Icon(
                        Icons.access_time,
                        size: 14,
                        color: AppColors.textMuted,
                      ),
                      const SizedBox(width: 4),
                      Text(
                        Formatters.duration(_lesson.duration),
                        style: const TextStyle(
                          fontSize: 12,
                          color: AppColors.textMuted,
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 20),

                  // Titre
                  Text(
                    _lesson.title,
                    style: const TextStyle(
                      fontSize: 22,
                      fontWeight: FontWeight.bold,
                      color: AppColors.textPrimary,
                      height: 1.3,
                    ),
                  ),
                  const SizedBox(height: 20),

                  // Contenu
                  Text(
                    _(widget.widget.lesson.content ?? "").isEmpty
                        ? 'Contenu f  venir...'
                        : _lesson.content,
                    style: const TextStyle(
                      fontSize: 15,
                      color: AppColors.textPrimary,
                      height: 1.7,
                    ),
                  ),
                  const SizedBox(height: 100),
                ],
              ),
            ),
          ),
        ],
      ),

      // ---------------- BOTTOM BAR ----------------
      bottomNavigationBar: Container(
        padding: const EdgeInsets.fromLTRB(20, 12, 20, 20),
        decoration: BoxDecoration(
          color: Colors.white,
          boxShadow: [
            BoxShadow(
              color: Colors.black.withValues(alpha: 0.05),
              blurRadius: 12,
              offset: const Offset(0, -4),
            ),
          ],
        ),
        child: SafeArea(
          top: false,
          child: Row(
            children: [
              Expanded(
                child: OutlinedButton.icon(
                  onPressed: () => Navigator.pop(context),
                  icon: const Icon(Icons.arrow_back, size: 18),
                  label: const Text('Prfcfdent'),
                ),
              ),
              const SizedBox(width: 12),
              Expanded(
                child: ElevatedButton.icon(
                  onPressed: _toggleCompleted,
                  style: ElevatedButton.styleFrom(
                    backgroundColor:
                        _completed ? AppColors.success : AppColors.mauve,
                  ),
                  icon: Icon(
                    _completed
                        ? Icons.check_circle
                        : Icons.check_circle_outline,
                    size: 18,
                  ),
                  label: Text(_completed ? 'Terminf' : 'Marquer terminf'),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}