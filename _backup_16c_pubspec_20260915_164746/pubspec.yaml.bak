name: chefunitplus
description: ChefUnitPlus - Plateforme mobile de formation en leadership
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '>=3.3.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter
  cupertino_icons: ^1.0.6
  printing: ^5.13.4
  pdf: ^3.11.1
  printing: ^5.13.4
  pdf: ^3.11.1
  fl_chart: ^0.69.0
  http_parser: ^4.0.2
  file_picker: ^8.0.0
  qr_flutter: ^4.1.0
  provider: ^6.1.2
  http: ^1.2.0
  shared_preferences: ^2.2.3
  intl: ^0.19.0
  cached_network_image: ^3.3.1

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^4.0.0

flutter:
  uses-material-design: true
  assets:
    - assets/images/
    - assets/icons/
