// ChefUnitPlus - Modele Formation
const db = require('../config/database');

const Formation = {
  findById(id) {
    return db.prepare(
      'SELECT f.*, u.full_name as director_name FROM formations f LEFT JOIN users u ON f.director_id = u.id WHERE f.id = ?'
    ).get(id);
  },

  listPublished() {
    return db.prepare(
      'SELECT f.*, u.full_name as director_name FROM formations f LEFT JOIN users u ON f.director_id = u.id WHERE f.is_published = 1 ORDER BY f.created_at DESC'
    ).all();
  },

  listByDirector(directorId) {
    return db.prepare(
      'SELECT * FROM formations WHERE director_id = ? ORDER BY created_at DESC'
    ).all(directorId);
  },

  create({ id, title, description, price, currency, coverImage, directorId }) {
    db.prepare(
      'INSERT INTO formations (id, title, description, price, currency, cover_image, director_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
    ).run(id, title, description, price, currency, coverImage, directorId);
    return this.findById(id);
  },

  update(id, fields) {
    const allowed = ['title', 'description', 'price', 'currency', 'cover_image', 'is_published'];
    const updates = [];
    const values = [];
    Object.entries(fields).forEach(([k, v]) => {
      if (allowed.includes(k) && v !== undefined) {
        updates.push(k + ' = ?');
        values.push(v);
      }
    });
    if (updates.length === 0) return this.findById(id);
    values.push(id);
    db.prepare('UPDATE formations SET ' + updates.join(', ') + ' WHERE id = ?').run(...values);
    return this.findById(id);
  },

  delete(id) {
    db.prepare('DELETE FROM formations WHERE id = ?').run(id);
  }

  // Auto-ajoute : liste toutes les formations
  listAll() {
    try {
      return db.prepare(`SELECT * FROM formations WHERE is_published = 1 ORDER BY created_at DESC`).all();
    } catch (e) {
      try {
        return db.prepare(`SELECT * FROM formations ORDER BY created_at DESC`).all();
      } catch (e2) {
        return [];
      }
    }
  }
};;

module.exports = Formation;