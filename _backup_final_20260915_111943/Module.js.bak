// ChefUnitPlus - Modele Module
const db = require('../config/database');

const Module = {
  findById(id) {
    return db.prepare(
      'SELECT m.*, u.full_name as trainer_name FROM modules m LEFT JOIN users u ON m.trainer_id = u.id WHERE m.id = ?'
    ).get(id);
  },

  listByFormation(formationId) {
    return db.prepare(
      'SELECT m.*, u.full_name as trainer_name, (SELECT COUNT(*) FROM lessons WHERE module_id = m.id) as lesson_count FROM modules m LEFT JOIN users u ON m.trainer_id = u.id WHERE m.formation_id = ? ORDER BY m.order_index ASC'
    ).all(formationId);
  },

  listByTrainer(trainerId) {
    return db.prepare(
      'SELECT m.*, f.title as formation_title FROM modules m INNER JOIN formations f ON m.formation_id = f.id WHERE m.trainer_id = ? ORDER BY m.created_at DESC'
    ).all(trainerId);
  },

  create({ id, formationId, title, description, orderIndex = 0 }) {
    db.prepare(
      'INSERT INTO modules (id, formation_id, title, description, order_index) VALUES (?, ?, ?, ?, ?)'
    ).run(id, formationId, title, description, orderIndex);
    return this.findById(id);
  },

  assignTrainer(id, trainerId) {
    db.prepare('UPDATE modules SET trainer_id = ? WHERE id = ?').run(trainerId, id);
    return this.findById(id);
  },

  delete(id) {
    db.prepare('DELETE FROM modules WHERE id = ?').run(id);
  }
};

module.exports = Module;