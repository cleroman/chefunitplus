// =============================================================
// ChefUnitPlus - Modle Formation
// Une formation est cre par un directeur, contient des modules
// =============================================================


class Formation {
  final String id;
  final String title;
  final String description;
  final double price;
  final String currency;
  final String? coverImage;
  final String directorId;
  final String? directorName;
  final bool isPublished;
  final List<String> moduleIds; // IDs des modules rattachs
  final int enrolledCount; // Nombre d'apprenants inscrits
  final DateTime? createdAt;
  final DateTime? updatedAt;

  const Formation({
    required this.id,
    required this.title,
    required this.description,
    required this.price,
    this.currency = 'USD',
    this.coverImage,
    required this.directorId,
    this.directorName,
    this.isPublished = false,
    this.moduleIds = const [],
    this.enrolledCount = 0,
    this.createdAt,
    this.updatedAt,
  });

  // ===========================================================
  // Y FACTORIES
  // ===========================================================
  factory Formation.fromJson(Map<String, dynamic> json) {
    return Formation(
      id: (json['id'] ?? json['_id'] ?? '').toString(),
      title: json['title'] ?? '',
      description: json['description'] ?? '',
      price: _parseDouble(json['price']),
      currency: json['currency'] ?? 'USD',
      coverImage: json['coverImage'],
      directorId: (json['directorId'] ?? '').toString(),
      directorName: json['directorName'],
      isPublished: json['isPublished'] ?? false,
      moduleIds: (json['moduleIds'] as List?)
              ?.map((e) => e.toString())
              .toList() ??
          const [],
      enrolledCount: json['enrolledCount'] ?? 0,
      createdAt: _parseDate(json['createdAt']),
      updatedAt: _parseDate(json['updatedAt']),
    );
  }

  // ===========================================================
  // Y" S?RIALISATION
  // ===========================================================
  Map<String, dynamic> toJson() => {
        'id': id,
        'title': title,
        'description': description,
        'price': price,
        'currency': currency,
        if (coverImage != null) 'coverImage': coverImage,
        'directorId': directorId,
        if (directorName != null) 'directorName': directorName,
        'isPublished': isPublished,
        'moduleIds': moduleIds,
        'enrolledCount': enrolledCount,
        if (createdAt != null) 'createdAt': createdAt!.toIso8601String(),
        if (updatedAt != null) 'updatedAt': updatedAt!.toIso8601String(),
      };

  // ===========================================================
  // Y"< COPYWITH
  // ===========================================================
  Formation copyWith({
    String? id,
    String? title,
    String? description,
    double? price,
    String? currency,
    String? coverImage,
    String? directorId,
    String? directorName,
    bool? isPublished,
    List<String>? moduleIds,
    int? enrolledCount,
    DateTime? createdAt,
    DateTime? updatedAt,
  }) {
    return Formation(
      id: id ?? this.id,
      title: title ?? this.title,
      description: description ?? this.description,
      price: price ?? this.price,
      currency: currency ?? this.currency,
      coverImage: coverImage ?? this.coverImage,
      directorId: directorId ?? this.directorId,
      directorName: directorName ?? this.directorName,
      isPublished: isPublished ?? this.isPublished,
      moduleIds: moduleIds ?? this.moduleIds,
      enrolledCount: enrolledCount ?? this.enrolledCount,
      createdAt: createdAt ?? this.createdAt,
      updatedAt: updatedAt ?? this.updatedAt,
    );
  }

  // ===========================================================
  // Y" GETTERS UTILES
  // ===========================================================
  String get priceLabel => '\$${price.toStringAsFixed(2)} $currency';
  bool get isFree => price <= 0;
  int get moduleCount => moduleIds.length;

  // ===========================================================
  // Y COMPARAISON
  // ===========================================================
  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is Formation && runtimeType == other.runtimeType && id == other.id;

  @override
  int get hashCode => id.hashCode;

  @override
  String toString() => 'Formation(id: $id, title: $title, price: $price)';

  // ===========================================================
  // Y HELPERS PRIV?S
  // ===========================================================
  static double _parseDouble(dynamic v) {
    if (v == null) return 0.0;
    if (v is num) return v.toDouble();
    return double.tryParse(v.toString()) ?? 0.0;
  }

  static DateTime? _parseDate(dynamic v) {
    if (v == null) return null;
    if (v is DateTime) return v;
    return DateTime.tryParse(v.toString());
  }
}