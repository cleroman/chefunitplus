// ChefUnitPlus - Routes formations
const express = require('express');
const router = express.Router();
const ctrl = require('../controllers/formation.controller');
const { authenticate } = require('../middlewares/auth');
const { requireRole } = require('../middlewares/roleGuard');

// PUBLIC
router.get('/', ctrl.list);
router.get('/:id', ctrl.getById);
router.get('/:id/modules', ctrl.listModules);

// PROTEGE (directeur/admin)
router.post('/', authenticate, requireRole('directeur', 'admin'), ctrl.create);
router.patch('/:id', authenticate, requireRole('directeur', 'admin'), ctrl.update);
router.delete('/:id', authenticate, requireRole('directeur', 'admin'), ctrl.remove);

module.exports = router;