import '../core/constants/api_constants.dart';
import '../core/errors/error_handler.dart';
import '../models/formation.dart';
import 'api_client.dart';

class FormationService {
  final ApiClient _api;

  FormationService(this._api);

  /// Liste toutes les formations publiées
  Future<List<Formation>> list({String? search}) async {
    try {
      final data = await _api.get(
        ApiConstants.formations,
        query: search != null && search.isNotEmpty ? {'search': search} : null,
      );
      final list = data['formations'] as List? ?? data['data'] as List? ?? [];
      return list
          .map((e) => Formation.fromJson(e as Map<String, dynamic>))
          .toList();
    } catch (e, st) {
      ErrorHandler.log(e, st, 'FormationService.list');
      rethrow;
    }
  }

  /// Détail d'une formation
  Future<Formation> getById(String id) async {
    try {
      final data = await _api.get(
        ApiConstants.formationById.replaceAll('{id}', id),
      );
      return Formation.fromJson(
        (data['formation'] ?? data['data'] ?? data) as Map<String, dynamic>,
      );
    } catch (e, st) {
      ErrorHandler.log(e, st, 'FormationService.getById');
      rethrow;
    }
  }

  /// Modules d'une formation
  Future<List<Map<String, dynamic>>> listModules(String formationId) async {
    try {
      final data = await _api.get(
        ApiConstants.modulesByFormation.replaceAll('{id}', formationId),
      );
      final list = data['modules'] as List? ?? data['data'] as List? ?? [];
      return list.cast<Map<String, dynamic>>();
    } catch (e, st) {
      ErrorHandler.log(e, st, 'FormationService.listModules');
      rethrow;
    }
  }

  /// Créer une formation (directeur)
  Future<Formation> create(Map<String, dynamic> payload) async {
    try {
      final data = await _api.post(ApiConstants.formations, body: payload);
      return Formation.fromJson(
        (data['formation'] ?? data['data'] ?? data) as Map<String, dynamic>,
      );
    } catch (e, st) {
      ErrorHandler.log(e, st, 'FormationService.create');
      rethrow;
    }
  }

  /// Modifier une formation
  Future<Formation> update(String id, Map<String, dynamic> payload) async {
    try {
      final data = await _api.patch(
        ApiConstants.formationById.replaceAll('{id}', id),
        body: payload,
      );
      return Formation.fromJson(
        (data['formation'] ?? data['data'] ?? data) as Map<String, dynamic>,
      );
    } catch (e, st) {
      ErrorHandler.log(e, st, 'FormationService.update');
      rethrow;
    }
  }

  /// Supprimer une formation
  Future<void> delete(String id) async {
    try {
      await _api.delete(ApiConstants.formationById.replaceAll('{id}', id));
    } catch (e, st) {
      ErrorHandler.log(e, st, 'FormationService.delete');
      rethrow;
    }
  }
}