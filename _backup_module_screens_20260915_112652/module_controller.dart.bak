// =============================================================
// ChefUnitPlus - ModuleController
// Modules par formation + affectation formateur
// =============================================================

import 'package:flutter/foundation.dart';

import '../core/errors/error_handler.dart';
import '../models/module.dart';
import '../services/module_service.dart';


class ModuleController extends ChangeNotifier {
  final ModuleService _service;

  ModuleController(this._service);

  List<Module> _modules = [];
  bool _isLoading = false;
  String? _errorMessage;

  List<Module> get modules => _modules;
  bool get isLoading => _isLoading;
  String? get errorMessage => _errorMessage;

  // ===========================================================
  // ðŸ“‹ CHARGEMENT
  // ===========================================================
  Future<void> loadByFormation(String formationId) async {
    _isLoading = true;
    _errorMessage = null;
    notifyListeners();

    try {
      _modules = await _service.listByFormation(formationId);
    } catch (e, st) {
      _errorMessage = ErrorHandler.message(e);
      ErrorHandler.log(e, st, 'ModuleController.loadByFormation');
    } finally {
      _isLoading = false;
      notifyListeners();
    }
  }

  Future<void> loadMine() async {
    _isLoading = true;
    notifyListeners();

    try {
      _modules = await _service.listMine();
    } catch (e, st) {
      _errorMessage = ErrorHandler.message(e);
      ErrorHandler.log(e, st, 'ModuleController.loadMine');
    } finally {
      _isLoading = false;
      notifyListeners();
    }
  }

  // ===========================================================
  // âœï¸ CRUD
  // ===========================================================
  Future<Module?> create({
    required String formationId,
    required String title,
    String? description,
    int order = 0,
  }) async {
    try {
      final created = await _service.create(
        formationId: formationId,
        title: title,
        description: description,
        order: order,
      );
      _modules.add(created);
      _modules.sort((a, b) => a.order.compareTo(b.order));
      notifyListeners();
      return created;
    } catch (e, st) {
      _errorMessage = ErrorHandler.message(e);
      ErrorHandler.log(e, st, 'ModuleController.create');
      return null;
    }
  }

  Future<bool> update({
    required String id,
    String? title,
    String? description,
    int? order,
  }) async {
    try {
      final updated = await _service.update(
        id: id,
        title: title,
        description: description,
        order: order,
      );
      _replace(updated);
      return true;
    } catch (e, st) {
      _errorMessage = ErrorHandler.message(e);
      ErrorHandler.log(e, st, 'ModuleController.update');
      return false;
    }
  }

  Future<bool> delete(String id) async {
    try {
      await _service.delete(id);
      _modules.removeWhere((m) => m.id == id);
      notifyListeners();
      return true;
    } catch (e, st) {
      _errorMessage = ErrorHandler.message(e);
      ErrorHandler.log(e, st, 'ModuleController.delete');
      return false;
    }
  }

  // ===========================================================
  // ðŸ‘¨â€ðŸ« AFFECTATION FORMATEUR
  // ===========================================================
  Future<bool> assignTrainer({
    required String moduleId,
    required String trainerId,
  }) async {
    try {
      final updated = await _service.assignTrainer(
        moduleId: moduleId,
        trainerId: trainerId,
      );
      _replace(updated);
      return true;
    } catch (e, st) {
      _errorMessage = ErrorHandler.message(e);
      ErrorHandler.log(e, st, 'ModuleController.assignTrainer');
      return false;
    }
  }

  Future<bool> unassignTrainer(String moduleId) async {
    try {
      final updated = await _service.unassignTrainer(moduleId);
      _replace(updated);
      return true;
    } catch (e, st) {
      _errorMessage = ErrorHandler.message(e);
      ErrorHandler.log(e, st, 'ModuleController.unassignTrainer');
      return false;
    }
  }

  // ===========================================================
  // ðŸ§° HELPERS
  // ===========================================================
  void _replace(Module m) {
    final i = _modules.indexWhere((x) => x.id == m.id);
    if (i >= 0) _modules[i] = m;
    notifyListeners();
  }

  void clearError() {
    _errorMessage = null;
    notifyListeners();
  }
}