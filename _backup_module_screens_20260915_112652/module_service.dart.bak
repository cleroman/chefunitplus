// =============================================================
// ChefUnitPlus - Gestion des modules
// CRUD + affectation formateur
// =============================================================

import '../core/constants/api_constants.dart';
import '../core/errors/error_handler.dart';
import '../models/module.dart';
import 'api_client.dart';


class ModuleService {
  final ApiClient api;

  ModuleService(this.api);

  // ===========================================================
  // ðŸ“‹ LISTING
  // ===========================================================
  Future<List<Module>> listByFormation(String formationId) async {
    return ErrorHandler.guard(() async {
      final data = await api.get(
        ApiConstants.withId(ApiConstants.modulesByFormation, formationId),
      );
      final raw = data['modules'] as List? ?? const [];
      return raw
          .map((e) => Module.fromJson(e as Map<String, dynamic>))
          .toList()
        ..sort((a, b) => a.order.compareTo(b.order));
    }, context: 'ModuleService.listByFormation');
  }

  Future<List<Module>> listMine() async {
    return ErrorHandler.guard(() async {
      final data = await api.get('${ApiConstants.modules}/me');
      final raw = data['modules'] as List? ?? const [];
      return raw
          .map((e) => Module.fromJson(e as Map<String, dynamic>))
          .toList();
    }, context: 'ModuleService.listMine');
  }

  Future<Module> getById(String id) async {
    return ErrorHandler.guard(() async {
      final data = await api.get('${ApiConstants.modules}/$id');
      return Module.fromJson(data['module'] as Map<String, dynamic>);
    }, context: 'ModuleService.getById');
  }

  // ===========================================================
  // âœï¸ CRUD
  // ===========================================================
  Future<Module> create({
    required String formationId,
    required String title,
    String? description,
    int order = 0,
  }) async {
    return ErrorHandler.guard(() async {
      final data = await api.post(
        ApiConstants.modules,
        body: {
          'formationId': formationId,
          'title': title,
          if (description != null) 'description': description,
          'order': order,
        },
      );
      return Module.fromJson(data['module'] as Map<String, dynamic>);
    }, context: 'ModuleService.create');
  }

  Future<Module> update({
    required String id,
    String? title,
    String? description,
    int? order,
  }) async {
    return ErrorHandler.guard(() async {
      final data = await api.patch(
        '${ApiConstants.modules}/$id',
        body: {
          if (title != null) 'title': title,
          if (description != null) 'description': description,
          if (order != null) 'order': order,
        },
      );
      return Module.fromJson(data['module'] as Map<String, dynamic>);
    }, context: 'ModuleService.update');
  }

  Future<void> delete(String id) async {
    return ErrorHandler.guard(() async {
      await api.delete('${ApiConstants.modules}/$id');
    }, context: 'ModuleService.delete');
  }

  // ===========================================================
  // ðŸ‘¨â€ðŸ« AFFECTATION FORMATEUR
  // ===========================================================
  Future<Module> assignTrainer({
    required String moduleId,
    required String trainerId,
  }) async {
    return ErrorHandler.guard(() async {
      final data = await api.patch(
        ApiConstants.withId(ApiConstants.assignTrainer, moduleId),
        body: {'trainerId': trainerId},
      );
      return Module.fromJson(data['module'] as Map<String, dynamic>);
    }, context: 'ModuleService.assignTrainer');
  }

  Future<Module> unassignTrainer(String moduleId) async {
    return ErrorHandler.guard(() async {
      final data = await api.patch(
        ApiConstants.withId(ApiConstants.assignTrainer, moduleId),
        body: {'trainerId': null},
      );
      return Module.fromJson(data['module'] as Map<String, dynamic>);
    }, context: 'ModuleService.unassignTrainer');
  }
}