const db = require('../config/database');

const Module = {
  findById(id) {
    return db.prepare(`
      SELECT m.*, u.full_name as trainer_name
      FROM modules m
      LEFT JOIN users u ON m.trainer_id = u.id
      WHERE m.id = ?
    `).get(id);
  },

  listByFormation(formationId) {
    return db.prepare(`
      SELECT m.*, u.full_name as trainer_name,
        (SELECT COUNT(*) FROM lessons WHERE module_id = m.id) as lesson_count
      FROM modules m
      LEFT JOIN users u ON m.trainer_id = u.id
      WHERE m.formation_id = ?
      ORDER BY m."order" ASC
    `).all(formationId);
  },

  create({
    id, formationId, title, description, trainerId, order,
    hours, startDate, endDate, pdfPath
  }) {
    db.prepare(`
      INSERT INTO modules (
        id, formation_id, title, description, trainer_id,
        "order", hours, start_date, end_date, pdf_path, created_at
      )
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, datetime('now'))
    `).run(
      id, formationId, title || '', description || null, trainerId || null,
      order || 0, hours || 0, startDate || null, endDate || null, pdfPath || null
    );
    return this.findById(id);
  },

  update(id, fields) {
    const allowed = [
      'title', 'description', 'trainer_id', 'order',
      'hours', 'start_date', 'end_date', 'pdf_path'
    ];
    const updates = [];
    const values = [];
    Object.entries(fields).forEach(([k, v]) => {
      if (allowed.includes(k) && v !== undefined) {
        updates.push(k + ' = ?');
        values.push(v);
      }
    });
    if (updates.length === 0) return this.findById(id);
    updates.push('updated_at = CURRENT_TIMESTAMP');
    values.push(id);
    db.prepare(`UPDATE modules SET ${updates.join(', ')} WHERE id = ?`).run(...values);
    return this.findById(id);
  },

  delete(id) {
    db.prepare('DELETE FROM modules WHERE id = ?').run(id);
  },
};

module.exports = Module;