const express = require('express');
const router = express.Router();
const ctrl = require('../controllers/module.controller');
const { authenticate } = require('../middlewares/auth');
const { requireRole } = require('../middlewares/roleGuard');
const { uploadModulePdf } = require('../middlewares/upload');

router.use(authenticate);

router.get('/', ctrl.listByFormation);
router.get('/:id', ctrl.getById);

router.post('/', requireRole('directeur', 'admin', 'formateur'),
  uploadModulePdf, ctrl.create);
router.patch('/:id', requireRole('directeur', 'admin', 'formateur'),
  uploadModulePdf, ctrl.update);
router.delete('/:id', requireRole('directeur', 'admin'), ctrl.remove);

module.exports = router;