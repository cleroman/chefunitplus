import 'package:flutter/foundation.dart';

import '../core/constants/api_constants.dart';
import '../core/errors/app_exception.dart';
import '../core/errors/error_handler.dart';
import '../models/module.dart';
import '../services/api_client.dart';
import '../services/module_service.dart';

class ModuleController extends ChangeNotifier {
  final ModuleService _service;
  final ApiClient? _api;

  ModuleController(this._service, {ApiClient? api}) : _api = api;

  bool _loading = false;
  bool get isLoading => _loading;

  String? _error;
  String? get error => _error;
  String? get errorMessage => _error;

  List<Module> _modules = [];
  List<Module> get modules => _modules;

  // =========================================================
  // CHARGEMENT
  // =========================================================
  Future<void> load(String formationId, {bool refresh = false}) async {
    if (!refresh && _loading) return;
    _loading = true;
    _error = null;
    notifyListeners();

    try {
      _modules = await _service.listByFormation(formationId);
    } on AppException catch (e) {
      _error = e.message;
    } catch (e, st) {
      _error = ErrorHandler.message(e);
      ErrorHandler.log(e, st, 'ModuleController.load');
    }

    _loading = false;
    notifyListeners();
  }

  Future<void> loadByFormation(String formationId, {bool refresh = false}) =>
      load(formationId, refresh: refresh);

  // =========================================================
  // CREATE
  // =========================================================
  Future<bool> create({
    required String formationId,
    required String title,
    String? description,
    String? trainerId,
    int order = 0,
    int hours = 0,
    DateTime? startDate,
    DateTime? endDate,
    String? pdfFilePath,
  }) async {
    try {
      await _service.create(
        formationId: formationId,
        title: title,
        description: description,
        trainerId: trainerId,
        order: order,
        hours: hours,
        startDate: startDate,
        endDate: endDate,
        pdfFilePath: pdfFilePath,
      );
      await load(formationId, refresh: true);
      return true;
    } catch (e, st) {
      _error = ErrorHandler.message(e);
      notifyListeners();
      ErrorHandler.log(e, st, 'ModuleController.create');
      return false;
    }
  }

  // =========================================================
  // UPDATE
  // =========================================================
  Future<bool> update({
    required String id,
    required String formationId,
    String? title,
    String? description,
    String? trainerId,
    int? order,
    int? hours,
    DateTime? startDate,
    DateTime? endDate,
    String? pdfFilePath,
  }) async {
    try {
      await _service.update(
        id: id,
        title: title,
        description: description,
        trainerId: trainerId,
        order: order,
        hours: hours,
        startDate: startDate,
        endDate: endDate,
        pdfFilePath: pdfFilePath,
      );
      await load(formationId, refresh: true);
      return true;
    } catch (e, st) {
      _error = ErrorHandler.message(e);
      notifyListeners();
      ErrorHandler.log(e, st, 'ModuleController.update');
      return false;
    }
  }

  // =========================================================
  // DELETE
  // =========================================================
  Future<bool> delete(String id, String formationId) async {
    try {
      await _service.delete(id);
      await load(formationId, refresh: true);
      return true;
    } catch (e, st) {
      _error = ErrorHandler.message(e);
      notifyListeners();
      ErrorHandler.log(e, st, 'ModuleController.delete');
      return false;
    }
  }

  // =========================================================
  // ASSIGNER / RETIRER UN FORMATEUR
  // Accepte les 2 signatures
  // =========================================================
  Future<bool> assignTrainer(
    String? moduleIdPos,
    String? trainerIdPos, {
    String? moduleId,
    String? trainerId,
    String? formationId,
  }) async {
    final targetModuleId = moduleIdPos ?? moduleId;
    final targetTrainerId = trainerIdPos ?? trainerId;

    if (targetModuleId == null || targetTrainerId == null) {
      _error = 'moduleId et trainerId requis';
      notifyListeners();
      return false;
    }

    try {
      if (_api == null) {
        _error = 'ApiClient non fourni';
        notifyListeners();
        return false;
      }

      await _api.patch(
        '${ApiConstants.modules}/$targetModuleId',
        body: {'trainerId': targetTrainerId},
      );

      if (formationId != null) {
        await load(formationId, refresh: true);
      } else {
        final idx = _modules.indexWhere((m) => m.id == targetModuleId);
        if (idx >= 0) {
          final old = _modules[idx];
          _modules[idx] = Module(
            id: old.id,
            formationId: old.formationId,
            title: old.title,
            description: old.description,
            trainerId: targetTrainerId,
            trainerName: old.trainerName,
            order: old.order,
            hours: old.hours,
            startDate: old.startDate,
            endDate: old.endDate,
            pdfPath: old.pdfPath,
            lessonCount: old.lessonCount,
            createdAt: old.createdAt,
          );
        }
        notifyListeners();
      }
      return true;
    } catch (e, st) {
      _error = ErrorHandler.message(e);
      notifyListeners();
      ErrorHandler.log(e, st, 'ModuleController.assignTrainer');
      return false;
    }
  }

  Future<bool> unassignTrainer(
    String? moduleIdPos, {
    String? moduleId,
    String? formationId,
  }) async {
    final targetModuleId = moduleIdPos ?? moduleId;
    if (targetModuleId == null) {
      _error = 'moduleId requis';
      notifyListeners();
      return false;
    }

    try {
      if (_api == null) {
        _error = 'ApiClient non fourni';
        notifyListeners();
        return false;
      }

      await _api.patch(
        '${ApiConstants.modules}/$targetModuleId',
        body: {'trainerId': ''},
      );

      if (formationId != null) {
        await load(formationId, refresh: true);
      } else {
        final idx = _modules.indexWhere((m) => m.id == targetModuleId);
        if (idx >= 0) {
          final old = _modules[idx];
          _modules[idx] = Module(
            id: old.id,
            formationId: old.formationId,
            title: old.title,
            description: old.description,
            trainerId: null,
            trainerName: null,
            order: old.order,
            hours: old.hours,
            startDate: old.startDate,
            endDate: old.endDate,
            pdfPath: old.pdfPath,
            lessonCount: old.lessonCount,
            createdAt: old.createdAt,
          );
        }
        notifyListeners();
      }
      return true;
    } catch (e, st) {
      _error = ErrorHandler.message(e);
      notifyListeners();
      ErrorHandler.log(e, st, 'ModuleController.unassignTrainer');
      return false;
    }
  }

  void reset() {
    _modules = [];
    _error = null;
    _loading = false;
    notifyListeners();
  }
}