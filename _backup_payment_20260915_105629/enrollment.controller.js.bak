// ChefUnitPlus - Controller Enrollment
const db = require('../config/database');
const { v4: uuidv4 } = require('uuid');

function create(req, res, next) {
  try {
    const { formationId } = req.body;
    if (!formationId) {
      return res.status(422).json({ success: false, message: 'formationId requis' });
    }
    const id = uuidv4();
    db.prepare(`
      INSERT INTO enrollments (id, learner_id, formation_id, status, requested_at)
      VALUES (?, ?, ?, 'pending_payment', datetime('now'))
    `).run(id, req.user.id, formationId);
    const enrollment = db.prepare(`SELECT * FROM enrollments WHERE id = ?`).get(id);
    return res.status(201).json({ success: true, data: enrollment });
  } catch (err) {
    next(err);
  }
}

function myEnrollments(req, res, next) {
  try {
    let enrollments = [];
    try {
      enrollments = db.prepare(`
        SELECT e.*, f.title as formation_title
        FROM enrollments e
        LEFT JOIN formations f ON e.formation_id = f.id
        WHERE e.learner_id = ?
        ORDER BY e.requested_at DESC
      `).all(req.user.id);
    } catch (e) {
      enrollments = [];
    }
    return res.json({ success: true, data: enrollments });
  } catch (err) {
    next(err);
  }
}

function pendingForDirector(req, res, next) {
  try {
    let enrollments = [];
    try {
      enrollments = db.prepare(`
        SELECT e.*, f.title as formation_title
        FROM enrollments e
        LEFT JOIN formations f ON e.formation_id = f.id
        WHERE e.status = 'pending_director'
        ORDER BY e.requested_at DESC
      `).all();
    } catch (e) {
      enrollments = [];
    }
    return res.json({ success: true, data: enrollments });
  } catch (err) {
    next(err);
  }
}

function validate(req, res, next) {
  try {
    db.prepare(`UPDATE enrollments SET status = 'approved', validated_at = datetime('now') WHERE id = ?`).run(req.params.id);
    return res.json({ success: true, message: 'Inscription validee' });
  } catch (err) {
    next(err);
  }
}

function reject(req, res, next) {
  try {
    const { comment } = req.body;
    db.prepare(`UPDATE enrollments SET status = 'rejected', director_comment = ?, validated_at = datetime('now') WHERE id = ?`).run(comment || null, req.params.id);
    return res.json({ success: true, message: 'Inscription refusee' });
  } catch (err) {
    next(err);
  }
}

module.exports = { create, myEnrollments, pendingForDirector, validate, reject };