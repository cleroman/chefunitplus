// =============================================================
// ChefUnitPlus - Modle Enrollment (inscription)
// Cycle : pendingPayment ?' pendingDirector ?' approved / rejected
// =============================================================


enum EnrollmentStatus {
  pendingPayment, // cr, en attente de paiement
  pendingDirector, // pay, en attente de validation directeur
  approved, // valid ?' accs accord
  rejected, // refus par directeur
  failed, // paiement chou
  cancelled, // annul par l'apprenant
}

extension EnrollmentStatusX on EnrollmentStatus {
  String get label => switch (this) {
        EnrollmentStatus.pendingPayment => 'Paiement requis',
        EnrollmentStatus.pendingDirector => 'En attente',
        EnrollmentStatus.approved => 'Valid',
        EnrollmentStatus.rejected => 'Refus',
        EnrollmentStatus.failed => '?chou',
        EnrollmentStatus.cancelled => 'Annul',
      };

  /// L'apprenant peut-il accder au contenu ?
  bool get grantsAccess => this == EnrollmentStatus.approved;

  /// Peut-on encore agir dessus ?
  bool get isFinal =>
      this == EnrollmentStatus.approved ||
      this == EnrollmentStatus.rejected ||
      this == EnrollmentStatus.cancelled;

  bool get isPending =>
      this == EnrollmentStatus.pendingPayment ||
      this == EnrollmentStatus.pendingDirector;
}

class Enrollment {
  final String id;
  final String learnerId;
  final String learnerName;
  final String formationId;
  final String formationTitle;
  final String? formationCoverImage;
  final EnrollmentStatus status;
  final double amountPaid;
  final String currency;
  final String? paymentRef; // orderNumber FlexPaie
  final String? directorComment; // raison refus / note directeur
  final DateTime requestedAt;
  final DateTime? paidAt;
  final DateTime? validatedAt;

  const Enrollment({
    required this.id,
    required this.learnerId,
    required this.learnerName,
    required this.formationId,
    required this.formationTitle,
    this.formationCoverImage,
    required this.status,
    this.amountPaid = 0,
    this.currency = 'USD',
    this.paymentRef,
    this.directorComment,
    required this.requestedAt,
    this.paidAt,
    this.validatedAt,
  });

  // ===========================================================
  // Y FACTORIES
  // ===========================================================
  factory Enrollment.fromJson(Map<String, dynamic> json) {
    return Enrollment(
      id: (json['id'] ?? json['_id'] ?? '').toString(),
      learnerId: (json['learnerId'] ?? '').toString(),
      learnerName: json['learnerName'] ?? '',
      formationId: (json['formationId'] ?? '').toString(),
      formationTitle: json['formationTitle'] ?? '',
      formationCoverImage: json['formationCoverImage'],
      status: _parseStatus(json['status']),
      amountPaid: _parseDouble(json['amountPaid']),
      currency: json['currency'] ?? 'USD',
      paymentRef: json['paymentRef'],
      directorComment: json['directorComment'],
      requestedAt: _parseDate(json['requestedAt']) ?? DateTime.now(),
      paidAt: _parseDate(json['paidAt']),
      validatedAt: _parseDate(json['validatedAt']),
    );
  }

  // ===========================================================
  // Y" S?RIALISATION
  // ===========================================================
  Map<String, dynamic> toJson() => {
        'id': id,
        'learnerId': learnerId,
        'learnerName': learnerName,
        'formationId': formationId,
        'formationTitle': formationTitle,
        if (formationCoverImage != null)
          'formationCoverImage': formationCoverImage,
        'status': status.name,
        'amountPaid': amountPaid,
        'currency': currency,
        if (paymentRef != null) 'paymentRef': paymentRef,
        if (directorComment != null) 'directorComment': directorComment,
        'requestedAt': requestedAt.toIso8601String(),
        if (paidAt != null) 'paidAt': paidAt!.toIso8601String(),
        if (validatedAt != null) 'validatedAt': validatedAt!.toIso8601String(),
      };

  // ===========================================================
  // Y"< COPYWITH
  // ===========================================================
  Enrollment copyWith({
    String? id,
    String? learnerId,
    String? learnerName,
    String? formationId,
    String? formationTitle,
    String? formationCoverImage,
    EnrollmentStatus? status,
    double? amountPaid,
    String? currency,
    String? paymentRef,
    String? directorComment,
    DateTime? requestedAt,
    DateTime? paidAt,
    DateTime? validatedAt,
  }) {
    return Enrollment(
      id: id ?? this.id,
      learnerId: learnerId ?? this.learnerId,
      learnerName: learnerName ?? this.learnerName,
      formationId: formationId ?? this.formationId,
      formationTitle: formationTitle ?? this.formationTitle,
      formationCoverImage: formationCoverImage ?? this.formationCoverImage,
      status: status ?? this.status,
      amountPaid: amountPaid ?? this.amountPaid,
      currency: currency ?? this.currency,
      paymentRef: paymentRef ?? this.paymentRef,
      directorComment: directorComment ?? this.directorComment,
      requestedAt: requestedAt ?? this.requestedAt,
      paidAt: paidAt ?? this.paidAt,
      validatedAt: validatedAt ?? this.validatedAt,
    );
  }

  // ===========================================================
  // Y" GETTERS
  // ===========================================================
  bool get isApproved => status == EnrollmentStatus.approved;
  bool get isPending => status.isPending;
  bool get isRejected => status == EnrollmentStatus.rejected;
  bool get hasAccess => status.grantsAccess;

  String get amountLabel => '\$${amountPaid.toStringAsFixed(2)} $currency';

  // ===========================================================
  // Y COMPARAISON
  // ===========================================================
  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is Enrollment &&
          runtimeType == other.runtimeType &&
          id == other.id;

  @override
  int get hashCode => id.hashCode;

  @override
  String toString() =>
      'Enrollment(id: $id, status: ${status.name}, formation: $formationTitle)';

  // ===========================================================
  // Y HELPERS PRIV?S
  // ===========================================================
  static EnrollmentStatus _parseStatus(dynamic v) {
    if (v == null) return EnrollmentStatus.pendingPayment;
    final name = v.toString().toLowerCase();
    return EnrollmentStatus.values.firstWhere(
      (s) => s.name.toLowerCase() == name,
      orElse: () => EnrollmentStatus.pendingPayment,
    );
  }

  static double _parseDouble(dynamic v) {
    if (v == null) return 0.0;
    if (v is num) return v.toDouble();
    return double.tryParse(v.toString()) ?? 0.0;
  }

  static DateTime? _parseDate(dynamic v) {
    if (v == null) return null;
    if (v is DateTime) return v;
    return DateTime.tryParse(v.toString());
  }
}