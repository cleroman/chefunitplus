import '../core/constants/api_constants.dart';
import '../core/errors/error_handler.dart';
import '../models/enrollment.dart';
import 'api_client.dart';

class EnrollmentService {
  final ApiClient _api;

  EnrollmentService(this._api);

  Future<Enrollment> request(String formationId) async {
    try {
      final data = await _api.post(
        ApiConstants.enrollments,
        body: {'formationId': formationId},
      );
      return Enrollment.fromJson(
        (data['enrollment'] ?? data['data'] ?? data) as Map<String, dynamic>,
      );
    } catch (e, st) {
      ErrorHandler.log(e, st, 'EnrollmentService.request');
      rethrow;
    }
  }

  Future<List<Enrollment>> myEnrollments() async {
    try {
      final data = await _api.get(ApiConstants.myEnrollments);
      final list = data['enrollments'] as List? ?? data['data'] as List? ?? [];
      return list
          .map((e) => Enrollment.fromJson(e as Map<String, dynamic>))
          .toList();
    } catch (e, st) {
      ErrorHandler.log(e, st, 'EnrollmentService.myEnrollments');
      rethrow;
    }
  }

  Future<List<Enrollment>> pendingForDirector() async {
    try {
      final data = await _api.get(ApiConstants.pendingEnrollments);
      final list = data['enrollments'] as List? ?? data['data'] as List? ?? [];
      return list
          .map((e) => Enrollment.fromJson(e as Map<String, dynamic>))
          .toList();
    } catch (e, st) {
      ErrorHandler.log(e, st, 'EnrollmentService.pendingForDirector');
      rethrow;
    }
  }

  Future<void> validate(String enrollmentId, {String? comment}) async {
    try {
      await _api.patch(
        ApiConstants.validateEnrollment.replaceAll('{id}', enrollmentId),
        body: {
          if (comment != null && comment.isNotEmpty) 'comment': comment,
        },
      );
    } catch (e, st) {
      ErrorHandler.log(e, st, 'EnrollmentService.validate');
      rethrow;
    }
  }

  Future<void> reject(String enrollmentId, {String? comment}) async {
    try {
      await _api.patch(
        ApiConstants.rejectEnrollment.replaceAll('{id}', enrollmentId),
        body: {
          if (comment != null && comment.isNotEmpty) 'comment': comment,
        },
      );
    } catch (e, st) {
      ErrorHandler.log(e, st, 'EnrollmentService.reject');
      rethrow;
    }
  }
}