import 'package:flutter/material.dart';

import '../director/module_editor_screen.dart';

/// Wrapper pour que le formateur puisse aussi creer/editer un module.
/// Le vrai editor est dans `views/director/module_editor_screen.dart`.
class ModuleEditorScreen extends StatelessWidget {
  /// L'ID de la formation a laquelle rattacher le module.
  final String formationId;

  /// Un module existant (pour edition). null = creation.
  final dynamic existingModule;

  const ModuleEditorScreen({
    super.key,
    required this.formationId,
    this.existingModule,
  });

  @override
  Widget build(BuildContext context) {
    return DirectorModuleEditorScreen(
      formationId: formationId,
      existingModule: existingModule,
    );
  }
}