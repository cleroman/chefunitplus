// ChefUnitPlus - ModuleEditorScreen
// Création / édition d'un module
// =============================================================

import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

import '../../controllers/module_controller.dart';
import '../../core/constants/app_colors.dart';
import '../../core/utils/snackbar_helper.dart';
import '../../core/utils/validators.dart';
import '../../models/module.dart';


class ModuleEditorScreen extends StatefulWidget {
  ModuleEditorScreen({super.key});

  @override
  State<ModuleEditorScreen> createState() => _ModuleEditorScreenState();
}

class _ModuleEditorScreenState extends State<ModuleEditorScreen> {
  final _formKey = GlobalKey<FormState>();
  final _titleCtrl = TextEditingController();
  final _descCtrl = TextEditingController();
  final _orderCtrl = TextEditingController(text: '0');

  String? _moduleId;
  String? _formationId;
  Module? _existing;
  bool _initialized = false;
  bool _loading = false;

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    if (_initialized) return;
    _initialized = true;

    final args = ModalRoute.of(context)?.settings.arguments;
    if (args is Map) {
      _moduleId = args['moduleId']?.toString();
      _formationId = args['formationId']?.toString();
    }

    if (_moduleId != null) {
      final ctrl = context.read<ModuleController>();
      _existing = ctrl.modules.firstWhere(
        (m) => m.id == _moduleId,
        orElse: () => Module(
          id: _moduleId!,
          formationId: _formationId ?? '',
          title: '',
        ),
      );

      if (_existing!.title.isNotEmpty) {
        _titleCtrl.text = _existing!.title;
        _descCtrl.text = _existing!.description ?? '';
        _orderCtrl.text = _existing!.order.toString();
      }
    }
  }

  @override
  void dispose() {
    _titleCtrl.dispose();
    _descCtrl.dispose();
    _orderCtrl.dispose();
    super.dispose();
  }

  bool get _isEditing => _moduleId != null;

  Future<void> _submit() async {
    FocusScope.of(context).unfocus();
    if (!_formKey.currentState!.validate()) return;

    setState(() => _loading = true);
    final ctrl = context.read<ModuleController>();

    try {
      if (_isEditing) {
        final ok = await ctrl.update(
          id: _moduleId!,
          title: _titleCtrl.text.trim(),
          description: _descCtrl.text.trim(),
          order: int.tryParse(_orderCtrl.text.trim()) ?? 0,
        );
        if (!mounted) return;
        if (ok) {
          SnackbarHelper.success(context, 'Module mis à jour');
          Navigator.pop(context, true);
        } else {
          SnackbarHelper.error(
            context,
            ctrl.errorMessage ?? 'Erreur lors de la mise à jour',
          );
        }
      } else {
        if (_formationId == null) {
          SnackbarHelper.error(
            context,
            'Aucune formation associée à ce module',
          );
          setState(() => _loading = false);
          return;
        }
        final created = await ctrl.create(
          formationId: _formationId!,
          title: _titleCtrl.text.trim(),
          description: _descCtrl.text.trim(),
          order: int.tryParse(_orderCtrl.text.trim()) ?? 0,
        );
        if (!mounted) return;
        if (created != null) {
          SnackbarHelper.success(context, 'Module créé avec succès');
          Navigator.pop(context, true);
        } else {
          SnackbarHelper.error(
            context,
            ctrl.errorMessage ?? 'Erreur lors de la création',
          );
        }
      }
    } finally {
      if (mounted) setState(() => _loading = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: AppColors.background,
      appBar: AppBar(
        title: Text(_isEditing ? 'Modifier le module' : 'Créer un module'),
        backgroundColor: AppColors.success,
        foregroundColor: Colors.white,
      ),
      body: SafeArea(
        child: SingleChildScrollView(
          padding: const EdgeInsets.all(20),
          child: Form(
            key: _formKey,
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                // Bandeau info
                Container(
                  padding: const EdgeInsets.all(14),
                  decoration: BoxDecoration(
                    color: AppColors.successSoft.withValues(alpha: 0.5),
                    borderRadius: BorderRadius.circular(12),
                  ),
                  child: Row(
                    children: [
                      const Icon(
                        Icons.info_outline,
                        color: AppColors.success,
                        size: 20,
                      ),
                      const SizedBox(width: 12),
                      Expanded(
                        child: Text(
                          _isEditing
                              ? 'Modifiez les informations du module.'
                              : 'Remplissez le formulaire pour créer un nouveau module.',
                          style: const TextStyle(
                            fontSize: 12,
                            color: AppColors.successDark,
                            height: 1.4,
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 24),

                // Titre
                TextFormField(
                  controller: _titleCtrl,
                  textInputAction: TextInputAction.next,
                  textCapitalization: TextCapitalization.sentences,
                  decoration: const InputDecoration(
                    labelText: 'Titre du module',
                    hintText: 'Ex : Introduction au leadership',
                    prefixIcon: Icon(Icons.title),
                  ),
                  validator: (v) => Validators.required(v),
                ),
                const SizedBox(height: 16),

                // Description
                TextFormField(
                  controller: _descCtrl,
                  maxLines: 5,
                  textCapitalization: TextCapitalization.sentences,
                  decoration: const InputDecoration(
                    labelText: 'Description',
                    hintText: 'Décrivez le contenu du module...',
                    alignLabelWithHint: true,
                  ),
                ),
                const SizedBox(height: 16),

                // Ordre
                TextFormField(
                  controller: _orderCtrl,
                  keyboardType: TextInputType.number,
                  decoration: const InputDecoration(
                    labelText: 'Ordre d\'affichage',
                    hintText: '0',
                    prefixIcon: Icon(Icons.format_list_numbered),
                  ),
                  validator: (v) {
                    if (v == null || v.isEmpty) return null;
                    if (int.tryParse(v) == null) {
                      return 'Doit être un nombre';
                    }
                    return null;
                  },
                ),
                const SizedBox(height: 32),

                // Bouton submit
                SizedBox(
                  height: 52,
                  child: ElevatedButton.icon(
                    onPressed: _loading ? null : _submit,
                    style: ElevatedButton.styleFrom(
                      backgroundColor: AppColors.success,
                    ),
                    icon: _loading
                        ? const SizedBox(
                            width: 20,
                            height: 20,
                            child: CircularProgressIndicator(
                              color: Colors.white,
                              strokeWidth: 2.5,
                            ),
                          )
                        : const Icon(Icons.save_outlined),
                    label: Text(
                      _isEditing ? 'Enregistrer' : 'Créer le module',
                    ),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}