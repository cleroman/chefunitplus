// =============================================================
// ChefUnitPlus - Modele Complaint (reclamation)
// =============================================================

enum ComplaintStatus {
  pending,    // En attente
  inProgress, // En cours
  resolved,   // Resolue
  rejected,   // Rejetee
}

extension ComplaintStatusX on ComplaintStatus {
  String get label {
    switch (this) {
      case ComplaintStatus.pending:    return 'En attente';
      case ComplaintStatus.inProgress: return 'En cours';
      case ComplaintStatus.resolved:   return 'Resolue';
      case ComplaintStatus.rejected:   return 'Rejetee';
    }
  }

  static ComplaintStatus fromString(String? v) {
    if (v == null) return ComplaintStatus.pending;
    final s = v.toLowerCase();
    return ComplaintStatus.values.firstWhere(
      (x) => x.name.toLowerCase() == s,
      orElse: () => ComplaintStatus.pending,
    );
  }
}

class Complaint {
  final String id;
  final String userId;
  final String userFullName;
  final String subject;
  final String description;
  final ComplaintStatus status;
  final String? response;
  final DateTime createdAt;
  final DateTime? resolvedAt;

  const Complaint({
    required this.id,
    required this.userId,
    required this.userFullName,
    required this.subject,
    required this.description,
    this.status = ComplaintStatus.pending,
    this.response,
    required this.createdAt,
    this.resolvedAt,
  });

  factory Complaint.fromJson(Map<String, dynamic> json) => Complaint(
        id: (json['id'] ?? json['_id'] ?? '').toString(),
        userId: (json['userId'] ?? '').toString(),
        userFullName: json['userFullName'] ?? '',
        subject: json['subject'] ?? '',
        description: json['description'] ?? '',
        status: ComplaintStatusX.fromString(json['status']?.toString()),
        response: json['response'],
        createdAt: json['createdAt'] != null
            ? DateTime.tryParse(json['createdAt'].toString()) ?? DateTime.now()
            : DateTime.now(),
        resolvedAt: json['resolvedAt'] != null
            ? DateTime.tryParse(json['resolvedAt'].toString())
            : null,
      );

  Map<String, dynamic> toJson() => {
        'id': id,
        'userId': userId,
        'userFullName': userFullName,
        'subject': subject,
        'description': description,
        'status': status.name,
        if (response != null) 'response': response,
        'createdAt': createdAt.toIso8601String(),
        if (resolvedAt != null) 'resolvedAt': resolvedAt!.toIso8601String(),
      };

  Complaint copyWith({
    String? id,
    String? userId,
    String? userFullName,
    String? subject,
    String? description,
    ComplaintStatus? status,
    String? response,
    DateTime? createdAt,
    DateTime? resolvedAt,
  }) =>
      Complaint(
        id: id ?? this.id,
        userId: userId ?? this.userId,
        userFullName: userFullName ?? this.userFullName,
        subject: subject ?? this.subject,
        description: description ?? this.description,
        status: status ?? this.status,
        response: response ?? this.response,
        createdAt: createdAt ?? this.createdAt,
        resolvedAt: resolvedAt ?? this.resolvedAt,
      );

  bool get isPending => status == ComplaintStatus.pending;
  bool get isResolved => status == ComplaintStatus.resolved;
}